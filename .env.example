# Copy this file to .env and fill in values from
# Firebase console → Project settings → General → Your apps → Web app config.
# These are the PUBLIC client config values — safe to ship in the built app.
# The Anthropic API key is NOT set here — it lives only in the Cloud Function
# secret (see README "Set the Anthropic key" step).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
