{
  "name": "@talentlens/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --schema=src/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/db/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=src/db/schema.prisma",
    "db:seed": "ts-node src/db/seed.ts",
    "db:studio": "prisma studio --schema=src/db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@talentlens/shared-types": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "ioredis": "^5.3.2",
    "zod": "^3.23.0",
    "nanoid": "^5.0.7",
    "anthropic": "^0.26.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "prisma": "^5.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
